<?xml version="1.0" encoding="UTF-8"?>
<!-- Notes and canvases are ZIPs inside, so without this file managers open them as archives. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-xnote">
    <comment>xnotes note</comment>
    <comment xml:lang="ru">Заметка xnotes</comment>
    <sub-class-of type="application/zip"/>
    <icon name="application-x-xnote"/>
    <generic-icon name="x-office-document"/>
    <glob pattern="*.xnote"/>
  </mime-type>
  <mime-type type="application/x-xcanvas">
    <comment>xnotes canvas</comment>
    <comment xml:lang="ru">Холст xnotes</comment>
    <sub-class-of type="application/zip"/>
    <icon name="application-x-xcanvas"/>
    <generic-icon name="x-office-drawing"/>
    <glob pattern="*.xcanvas"/>
  </mime-type>
</mime-info>
